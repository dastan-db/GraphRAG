# Local-first development environment for GraphRAG agent
# Copy to .env.local and fill in your values.

# Backend: "local" (DuckDB) or "databricks" (Statement Execution API)
GRAPHRAG_BACKEND=local

# LLM provider: "openai", "ollama", or "databricks"
GRAPHRAG_LLM_PROVIDER=openai

# OpenAI (when GRAPHRAG_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (when GRAPHRAG_LLM_PROVIDER=ollama)
# OLLAMA_MODEL=llama3.1

# Gateway / LiteLLM proxy (when GRAPHRAG_LLM_PROVIDER=gateway)
# Routes through LiteLLM for multi-model testing via a single endpoint.
# GATEWAY_MODEL=gpt-4o-mini

# Local DuckDB path (when GRAPHRAG_BACKEND=local)
GRAPHRAG_LOCAL_DB=data/graphrag.duckdb

# Databricks auth (when using databricks backend or exporting data)
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_WAREHOUSE_ID=...

# ── LLM Gateway (LiteLLM Proxy) ──────────────────────────────
# Start with: python .forge/gateway/start_gateway.py
# Then set Cursor "Override OpenAI Base URL" to http://localhost:4000/v1

# Anthropic (for Claude models via gateway)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (for GPT models via gateway — also used when GRAPHRAG_LLM_PROVIDER=openai)
# Note: OPENAI_API_KEY is already defined above for direct local use.

# Gateway master key (auto-set to sk-forge-local-dev if not provided)
# LITELLM_MASTER_KEY=sk-forge-local-dev
LITELLM_BASE_URL=http://localhost:4000/v1
